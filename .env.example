# Required: OpenAI API key (on Render, set it in the dashboard, never commit it)
OPENAI_API_KEY=

# Optional
OPENAI_MODEL=gpt-6-luna
# $ per 1M tokens "input,cached,cache write,output"; only needed for models without a built-in price
# OPENAI_PRICE=0.10,0.01,0.125,0.50
ASTRO_MAX_TURNS=30
# Fallback USD->INR rate for cost display when the live rate is unavailable
USD_INR=96
# Where conversations and logs are stored (point at a persistent disk in production)
# DATA_DIR=/var/data
